rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function room(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function isOwner(roomData) {
      return isSignedIn() && request.auth.uid == roomData.ownerId;
    }

    function isController(roomData) {
      return isSignedIn() && request.auth.uid == roomData.controllerId;
    }

    function isFacilitator(roomData) {
      return isOwner(roomData) || isController(roomData);
    }

    function isApprovedMember(roomData) {
      return isSignedIn()
        && roomData.members[request.auth.uid] != null
        && roomData.members[request.auth.uid].status == 'approved';
    }

    function onlyChangedKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // deleteAt alimenta scripts/cleanup-rooms.mjs (cron do GitHub Actions) — o TTL nativo do
    // Firestore exigiria o plano pago Blaze, então a faxina é feita por fora, não por ele.
    // Entre agora e 48h, nunca no passado nem longe demais — evita abuso sem exigir precisão.
    function isValidDeleteAt() {
      return request.resource.data.deleteAt is timestamp
        && request.resource.data.deleteAt > request.time
        && request.resource.data.deleteAt < request.time + duration.value(48, 'h');
    }

    // dono ausente (heartbeat parado) ou sala sem nenhuma ação há muito tempo
    function isStale(roomData) {
      return (roomData.ownerLastSeen is timestamp && request.time > roomData.ownerLastSeen + duration.value(2, 'm'))
        || (roomData.lastActivityAt is timestamp && request.time > roomData.lastActivityAt + duration.value(60, 'm'));
    }

    // ---------- limites de uso (ver specs/limites-e-limpeza.md) ----------
    // Os padrões vivem aqui. config/limits (global) e userLimits/{uid} (por usuário) são
    // opcionais e só sobrescrevem; se não existirem, valem os padrões e nada trava.
    function limitsDoc() {
      return exists(/databases/$(database)/documents/config/limits)
        ? get(/databases/$(database)/documents/config/limits).data
        : {};
    }

    function userLimitsDoc(uid) {
      return exists(/databases/$(database)/documents/userLimits/$(uid))
        ? get(/databases/$(database)/documents/userLimits/$(uid)).data
        : {};
    }

    // mesmos valores do limits.service.ts (cliente); 1000 = "ilimitado" na prática
    function defaultMaxMembers() {
      return 8;
    }

    // valor digitado errado no console (string, decimal) é ignorado e cai pro próximo nível,
    // igual ao cliente; senão a comparação daria erro e travaria a criação de sala
    function intOr(value, fallback) {
      return value is int ? value : fallback;
    }

    function effectiveMaxMembers(uid) {
      let user = userLimitsDoc(uid);
      let global = limitsDoc();
      return user.get('unlimited', false) == true
        ? 1000
        : intOr(user.get('maxMembers', null), intOr(global.get('maxMembers', null), defaultMaxMembers()));
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;

      match /rooms/{roomId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ---------- limites: só leitura pelo cliente; quem escreve é o console/Admin SDK ----------
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /userLimits/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- pointing types (seed, somente leitura) ----------
    match /pointingTypes/{typeId} {
      allow read: if isSignedIn();
      allow write: if false; // gerido via console/script admin
    }

    // ---------- rooms ----------
    match /rooms/{roomId} {
      allow get: if isSignedIn();
      allow list: if false; // sem enumeração de salas

      // só conta cadastrada cria sala: convidado anônimo pode entrar em salas, não criar (evita spam de salas)
      allow create: if isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.controllerId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.members.size() == 1
        && request.resource.data.members[request.auth.uid].status == 'approved'
        && request.resource.data.members[request.auth.uid].role == 'owner'
        // maxMembers é opcional (cliente antigo não manda); se vier, não passa do limite do dono
        && (!('maxMembers' in request.resource.data)
            || (request.resource.data.maxMembers is int
                && request.resource.data.maxMembers <= effectiveMaxMembers(request.auth.uid)));

      // convidado/usuário pede pra entrar (só adiciona a si mesmo, pending); sala cheia
      // (aprovados + pendentes) não aceita mais pedidos
      allow update: if isSignedIn()
        && onlyChangedKeys(['members'])
        && resource.data.members.size() < resource.data.get('maxMembers', defaultMaxMembers())
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.members[request.auth.uid].status == 'pending'
        && request.resource.data.members[request.auth.uid].role == 'member'
        && request.resource.data.members.diff(resource.data.members)
             .affectedKeys().hasOnly([request.auth.uid]);

      // dono aprova/rejeita/remove membro; não infla a lista além do teto (sala antiga que já
      // passa dele pode só encolher ou ficar igual)
      allow update: if isOwner(resource.data)
        && onlyChangedKeys(['members', 'lastActivityAt'])
        && (request.resource.data.members.size() <= resource.data.members.size()
            || request.resource.data.members.size() <= resource.data.get('maxMembers', defaultMaxMembers()));

      // dono encerra a sala manualmente
      allow update: if isOwner(resource.data)
        && onlyChangedKeys(['status', 'deleteAt'])
        && resource.data.status == 'open' && request.resource.data.status == 'closed'
        && isValidDeleteAt();

      // dono elege/troca o controlador (só pra alguém já aprovado)
      allow update: if isOwner(resource.data)
        && onlyChangedKeys(['controllerId', 'lastActivityAt'])
        && resource.data.members[request.resource.data.controllerId].status == 'approved';

      // controlador (ou dono) aponta a rodada ativa
      allow update: if isFacilitator(resource.data)
        && onlyChangedKeys(['currentRoundId', 'lastActivityAt'])
        && resource.data.status == 'open';

      // heartbeat do dono (fase 2: detecta dono ausente)
      allow update: if isOwner(resource.data) && onlyChangedKeys(['ownerLastSeen']);

      // qualquer aprovado registra atividade (voto, revelação), sem outro poder
      allow update: if isApprovedMember(resource.data) && onlyChangedKeys(['lastActivityAt']);

      // encerramento automático: qualquer aprovado pode encerrar, mas só quando o
      // próprio servidor confirma que o dono está ausente ou a sala ficou inativa
      allow update: if isApprovedMember(resource.data)
        && onlyChangedKeys(['status', 'deleteAt'])
        && resource.data.status == 'open' && request.resource.data.status == 'closed'
        && isValidDeleteAt()
        && isStale(resource.data);

      allow delete: if isOwner(resource.data);
    }

    // ---------- rounds ----------
    match /rooms/{roomId}/rounds/{roundId} {
      allow read: if isApprovedMember(room(roomId));

      allow create: if isFacilitator(room(roomId))
        && request.resource.data.revealed == false
        && request.resource.data.startedBy == request.auth.uid;

      // revelar: só facilitador, só false -> true, e só esses campos
      allow update: if isFacilitator(room(roomId))
        && onlyChangedKeys(['revealed', 'revealedAt', 'revealedBy'])
        && resource.data.revealed == false
        && request.resource.data.revealed == true;

      // "eu já votei" — qualquer aprovado marca a própria chave, sem revelar valor
      allow update: if isApprovedMember(room(roomId))
        && onlyChangedKeys(['voters'])
        && resource.data.revealed == false
        && request.resource.data.voters.diff(resource.data.voters)
             .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.voters[request.auth.uid] == true;

      // decide (ou corrige) a nota final combinada depois da discussão -- só facilitador,
      // só depois de revelado; pode ser trocada mais de uma vez, sem trava de "só uma vez"
      allow update: if isFacilitator(room(roomId))
        && onlyChangedKeys(['finalValue', 'finalSetBy', 'finalSetAt'])
        && resource.data.revealed == true;

      match /votes/{uid} {
        function roundData() {
          return get(/databases/$(database)/documents/rooms/$(roomId)/rounds/$(roundId)).data;
        }

        allow read: if isSignedIn() && (
          request.auth.uid == uid ||
          (roundData().revealed == true && isApprovedMember(room(roomId)))
        );

        allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && isApprovedMember(room(roomId))
          && roundData().revealed == false;

        allow delete: if false;
      }
    }
  }
}
